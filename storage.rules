rules_version = '2';

// Storage rules for incident photos at incident_photos/{incidentId}/{file}.
//
// Ownership problem: photos are uploaded BEFORE the incident document is
// written (so the document only ever contains working URLs). At upload time
// there is no Firestore document to check ownership against. The rules solve
// this in two parts:
//   1. Every upload must carry custom metadata ownerUid == the uploader's uid,
//      so each file records who uploaded it.
//   2. Uploading into an EXISTING incident's folder is only allowed for its
//      reporter (while 'submitted') or staff, checked with firestore.get().
// Remaining trade-off: any verified user can upload into the folder of an
// incident id that does not exist yet. They can only add files tagged with
// their own uid, cannot overwrite or delete anyone else's, and the files are
// never referenced by a document they do not own.
service firebase.storage {
  match /b/{bucket}/o {

    function verified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
             .matches('^[^@]+@(alustudent[.]com|alueducation[.]com|alueducation[.]si[.]com)$');
    }

    function incidentPath(incidentId) {
      return /databases/(default)/documents/incidents/$(incidentId);
    }

    function isStaff() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role == 'staff';
    }

    // New incident (no document yet), or the caller's own incident that
    // staff have not started on.
    function reporterMayChange(incidentId) {
      return !firestore.exists(incidentPath(incidentId))
        || (firestore.get(incidentPath(incidentId)).data.reporterId
              == request.auth.uid
            && firestore.get(incidentPath(incidentId)).data.status
              == 'submitted');
    }

    match /incident_photos/{incidentId}/{fileName} {
      allow read: if verified();

      // Images only, under 5 MB (mirrors Limits.maxPhotoBytes), tagged with
      // the uploader. No overwriting existing files.
      allow create: if verified()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.ownerUid == request.auth.uid
        && (reporterMayChange(incidentId) || isStaff());

      allow update: if false;

      // The uploader (while the report is still editable, or after the
      // report was deleted, for cleanup) or staff.
      allow delete: if verified()
        && ((resource.metadata.ownerUid == request.auth.uid
             && reporterMayChange(incidentId))
            || isStaff());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
